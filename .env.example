# ============================================================
# MIHAD FREE VIDEO - Environment Variables
# ============================================================
# Copy this file to ".env" (or ".env.local") and fill in the values.
#
# 1) Cloudflare D1 (database)
#    Create a free D1 database at https://dash.cloudflare.com
#    See README.md -> "Database Setup" for the exact steps.
# ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_D1_API_TOKEN=your_d1_read_write_api_token

# 2) Admin authentication (JWT)
#    Generate a long random string: `openssl rand -base64 48`
# ------------------------------------------------------------
AUTH_SECRET=replace_with_a_long_random_secret_string
SESSION_COOKIE_NAME=mihad_admin_session
# Session lifetime in seconds (default: 7 days)
SESSION_MAX_AGE=604800

# 3) Initial admin account (used by `npm run setup:admin`)
#    After seeding, change the password from the admin Settings page.
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow123!

# 4) Public site URL (used for SEO: sitemap, canonical, OpenGraph)
#    Set this to your production domain on Vercel.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Mihad Free Video

# 5) PWA / Ads toggles (optional overrides of DB settings)
# ------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_PWA=true
# NEXT_PUBLIC_ENABLE_ADS=true
